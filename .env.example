# Copy this file to .env, set restrictive permissions, and replace every
# REPLACE_* value before starting compose.prod.yaml.

# Prefer the full sha-<git-sha> tag published by CI or an immutable manifest
# digest such as ghcr.io/krbob/wklejka@sha256:...
WKLEJKA_IMAGE=ghcr.io/krbob/wklejka:sha-REPLACE_WITH_FULL_GIT_SHA
WKLEJKA_HOST_PORT=3000
WKLEJKA_DATA_VOLUME=wklejka-data

# The production Compose profile intentionally requires token authentication.
AUTH_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
AUTH_COOKIE_SECURE=true

# Exact public HTTPS origin, without a path or trailing slash.
PUBLIC_ORIGIN=https://clipboard.example.net
TRUST_PROXY=1

HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=false
LOG_REQUESTS=true

MAX_CLIP_BINARY_BYTES=104857600
MAX_STORAGE_BYTES=5368709120
CLIP_RETENTION_MS=0
