{
  "name": "wklejka",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted shared clipboard for text, images, and files across devices",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krbob/wklejka.git"
  },
  "homepage": "https://github.com/krbob/wklejka#readme",
  "bugs": {
    "url": "https://github.com/krbob/wklejka/issues"
  },
  "main": "server.js",
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-timeout=15000",
    "test:coverage": "node --test --experimental-test-coverage --test-timeout=15000 --test-coverage-include='lib/**/*.js' --test-coverage-include='public/highlight.js' --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=80",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --project jsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run test:coverage"
  },
  "dependencies": {
    "express": "^5.0.0",
    "proxy-addr": "^2.0.7",
    "qrcode-generator": "2.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.3",
    "@types/proxy-addr": "2.0.3",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "typescript": "5.9.3"
  }
}
